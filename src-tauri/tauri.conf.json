{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "pomodo",
	"version": "0.2.0",
	"identifier": "com.samuk.pomodo",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "pomodo",
				"width": 400,
				"height": 900,
				"resizable": true,
				"minWidth": 150,
				"minHeight": 100,
				"decorations": true,
				"transparent": false,
				"center": true,
				"visible": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"shortDescription": "Cross-platform Pomodoro timer",
		"longDescription": "Cross-platform Pomodoro timer and task manager for Desktop, Android, and iOS.",
		"copyright": "© 2026 Kasame",
		"category": "Productivity",
		"license": "FSL-1.1-MIT"
	}
}