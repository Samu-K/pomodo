{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "pomodo",
	"version": "0.1.0",
	"identifier": "com.samuk.pomodo",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "pomodo",
				"width": 400,
				"height": 900,
				"resizable": true,
				"minWidth": 350,
				"minHeight": 600,
				"decorations": true,
				"transparent": false,
				"center": true,
				"visible": false
			},
			{
				"label": "splashscreen",
				"title": "Splashscreen",
				"url": "splashscreen.html",
				"width": 400,
				"height": 900,
				"decorations": false,
				"center": true,
				"transparent": true,
				"alwaysOnTop": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
